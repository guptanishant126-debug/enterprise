# ====================================================================
# SYSTEM 2: SERVER (Express API on Render)
# Environment variables for Render Dashboard > Environment
# ====================================================================

PORT=5000
NODE_ENV=production

# Client origin for CORS (Your Vercel deployment URL)
CLIENT_URL=https://nexus-enterprise.vercel.app

# JWT signing secret (min 32 characters)
JWT_SECRET=super_secret_enterprise_jwt_signing_key_at_least_32_chars_2026

# Google Gemini API Key for Server-side AI evaluation (gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

